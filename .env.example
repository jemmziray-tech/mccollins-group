# Database (Prisma + Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# NextAuth Configuration
NEXTAUTH_SECRET="your-strong-random-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin Authorization (Comma-separated privileged admin email list)
ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Concierge
GEMINI_API_KEY="your-gemini-api-key"

# Database Seeding Secret (Optional header: x-seed-secret)
SEED_SECRET="your-optional-seed-secret"
